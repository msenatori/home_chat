# ============================================================================
# Proxy de la red de casa + deploy  (deploy/lan-proxy, scripts/deploy.sh, npm run qr)
# ============================================================================
# Valores de ejemplo: reemplazalos por los tuyos. Sin comillas y sin comentarios en la misma línea.
#
# --- En la compu desde la que deployás: copiá a .env en la raíz del repo (gitignored) ---
# Host o alias de ssh del server.
SSH_HOST=mi-server
# Carpeta del código, relativa al home remoto.
REMOTE_DIR=shareit
# Opcional: dirección del QR de `npm run qr` (por defecto https://$BASE_DOMAIN).
# QR_URL=https://casa.example.com
# (deploy.sh y `npm run qr` también leen APP_PORT y BASE_DOMAIN de acá abajo.)
#
# --- En el server: copiá a ~/shareit-data/proxy.env (lo leen docker compose y lanapp) ---
# El token de Cloudflare va aparte: ~/shareit-data/cloudflare.env con CF_API_TOKEN=... (modo 600).
#
# IPv4 del server en la LAN. Caddy escucha SOLO acá y en 127.0.0.1.
LAN_IP=192.0.2.10
# Opcional: IPv6 ULA (fdxx:...) del server, para que los .local no tarden por IPv6. Nunca una pública.
LAN_IPV6=
# Dominio en Cloudflare. DNS: BASE_DOMAIN y *.BASE_DOMAIN → A LAN_IP (solo DNS, sin proxy).
BASE_DOMAIN=casa.example.com
# La app también responde en APP_NAME.BASE_DOMAIN; http://APP_NAME.local redirige a HTTPS.
APP_NAME=chat
# Puerto local de la app (127.0.0.1).
APP_PORT=8787
# Opcional: nombre mDNS del server (<nombre>.local), que también redirige a la app.
LOCAL_HOSTNAME=
#
# mdns-alias (root) puede leer LAN_IP / LAN_IPV6 de /etc/default/mdns-alias; si faltan, los detecta.

# ============================================================================
# App (server/): copiá lo que necesites a ~/shareit-data/env en el server
# (lo leen el servicio systemd y scripts/shareit-admin.sh). Todo es opcional:
# los valores de abajo son los predeterminados.
# ============================================================================
# Nombre que se ve en la app, la pestaña y al "agregar a inicio".
SHAREIT_APP_NAME=Charla en familia
SHAREIT_APP_SHORT_NAME=Charla
# Archivo opcional con las instrucciones del asistente (idioma, tono). Vacío = las de fábrica (español rioplatense).
SHAREIT_INSTRUCTIONS_FILE=
# Ingreso: device (escribir el nombre y que un admin apruebe el dispositivo), passkey o pin.
SHAREIT_AUTH=device
SHAREIT_REQUEST_MINUTES=15
# Mismo celular, otro navegador/app instalada: aprobar solo si la persona ya tiene un dispositivo
# usado en los últimos N días desde la misma IP (0 = apagado).
SHAREIT_AUTO_APPROVE_DAYS=30
SHAREIT_SESSION_DAYS=365
# Red: escucha en todas las interfaces (IPv4+IPv6) y solo acepta clientes de la red local.
SHAREIT_HOST=::
SHAREIT_PORT=8787
SHAREIT_LAN_ONLY=1
# Datos (base, adjuntos, carpeta de trabajo vacía) y el CLI de tu suscripción de IA (modo headless app-server).
SHAREIT_DATA_DIR=~/shareit-data
# Binario del CLI (vacío = el predeterminado) y su carpeta de estado (vacío = ~/.<nombre-del-cli>).
SHAREIT_LLM_BIN=
SHAREIT_LLM_HOME=
# Modelo/razonamiento por defecto (vacío = el predeterminado del proveedor) y si cada persona puede elegir.
SHAREIT_LLM_MODEL=
SHAREIT_LLM_EFFORT=
SHAREIT_MODEL_PICKER=1
# Dibujos con la herramienta de imágenes del CLI (0 = apagado).
SHAREIT_IMAGE_GENERATION=1
# Adjuntos y reportes.
SHAREIT_MAX_UPLOAD_MB=20
SHAREIT_TZ_OFFSET_MIN=-180
# Solo con SHAREIT_AUTH=passkey (necesita HTTPS en un dominio propio):
# SHAREIT_RP_ID=casa.example.com
# SHAREIT_ORIGINS=https://casa.example.com,https://chat.casa.example.com
# SHAREIT_PUBLIC_URL=https://chat.casa.example.com
# SHAREIT_INVITE_HOURS=24
